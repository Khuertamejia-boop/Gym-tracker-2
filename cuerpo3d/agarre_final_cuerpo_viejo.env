# FINAL bar grip (approved by the owner 20-10-2026). Every animation with a bar sources this file.
# base model: w/SMH_w63.blend (finger bones traced, weights WSM=60, CS group, hand skin smoothed)
export AGARRE_BASE=SMH_a4.blend   # SMH_p7 + arm proportions (armfix.py DU=0.04 KU=0.80 KE=0.78 KF=0.86 ELSM=60); athletic physique (physique.py on SMH_w74d: K_LAT=2.3 K_DELT=1.8 K_TRAP=1.3 K_ARM=1.2 SIGD=0.05 POSTN=40 LZC=1.20 LZW=0.11 SZC=1.22 K_SER=0.5)
export TIPOS=1.0 TOVK=0.6 TBEND=20 TMODE=over
export WRAP=250 WRAPP=0.90 CLR=-0.0015 CLR3=0.002 CLRP=0.001
export DS=-0.010 DN=0.020 FY=0.3 HST=0.8 CSIT=40 CSF=1.0 BARR=0.0145
export BARUNI=1   # pull-ups: plain bar
export HFIX=${GT3D:-/tmp/claude-0/-home-user-Gym-tracker-2/8036e25a-39fc-507e-8939-935aaa1c5ddc/scratchpad}/agarre_final_mano.json   # same hand angle to the bar in every frame
export ROLL=35 CLV=35 LATK=0 CS2IT=100 S2D0=0.10 S2D1=0.24   # dead hang; for P~0.4 use CLV=28
# after pullup4.py ALWAYS run: XR0=0.12 ZR1=1.42 UARM=0.9 YR1=0.15 fair.py posed.blend posed_F.blend  (smooth strip under the arm, bakes the mesh)
